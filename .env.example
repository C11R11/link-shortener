APP_PORT=3000
SHORTENER_DOMAIN=go.example.com
SHORTENER_SCHEME=https
DATABASE_URL=postgres://user:password@localhost:5432/dbname
ADMIN_TOKEN=change-me
REDIRECT_STATUS_CODE=302
# Set to "production" in deployed environments. When production, error
# responses return generic messages instead of the raw error.message,
# and Pino uses the info log level.
NODE_ENV=production
