APP_PORT=3000
SHORTENER_DOMAIN=go.example.com
SHORTENER_SCHEME=https
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Session auth: required for admin login. SESSION_SECRET must be at least
# 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-characters-of-random-data
# Session lifetime in seconds. Default 7 days.
SESSION_MAX_AGE_SECONDS=604800
# Names of the signed session and CSRF cookies. Defaults are usually fine.
SESSION_COOKIE_NAME=link_shortener_session
CSRF_COOKIE_NAME=link_shortener_csrf

# Legacy fallback (optional, deprecated). When set, this token still
# authenticates the JSON API (/api/*) via `Authorization: Bearer <token>`
# or `Authorization: Basic base64(:<token>)`. The HTML dashboard
# (/admin/*) requires a session login regardless. Recommended removal
# after creating an admin user with `npm run create-admin`.
# ADMIN_TOKEN=change-me

REDIRECT_STATUS_CODE=302
# Set to "production" in deployed environments. When production, error
# responses return generic messages instead of the raw error.message,
# and Pino uses the info log level.
NODE_ENV=production
